# ---------------------------------------------------------------- sitio ----
NEXT_PUBLIC_SITE_URL=https://onnismeeks.com

# ------------------------------------------------------------- Supabase ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta. Solo del lado del servidor, nunca con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------- YouTube ----
# Google Cloud Console > APIs > YouTube Data API v3 > Credenciales
YOUTUBE_API_KEY=
# Uno de los dos alcanza. El id empieza con UC.
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@onnismeeks

# ------------------------------------------------------------------- IA ----
# https://console.groq.com/keys (gratis)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------- automatismos ---
# Cadena larga y aleatoria. Protege /api/sync para el cron de Vercel.
CRON_SECRET=
# Opcional. Valida la firma del webhook de YouTube (PubSubHubbub).
PUBSUB_SECRET=

# ------------------------------------------------------------- showreel ----
# Id del video del showreel, el que va después de v= en la URL de YouTube.
NEXT_PUBLIC_SHOWREEL_YOUTUBE_ID=
# Opcional. Loop corto y liviano para el fondo del hero, por ejemplo /showreel.mp4
NEXT_PUBLIC_SHOWREEL_MP4=
# Opcional. Imagen de respaldo del hero.
NEXT_PUBLIC_SHOWREEL_POSTER=

# ---------------------------------------------------------------- redes ----
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@onnismeeks

# --- Aviso por correo de las consultas del formulario (opcional) ---
# Sin esto el formulario sigue funcionando: los mensajes quedan en /admin/mensajes.
# Con esto, ademas llega un aviso al buzon corporativo.
# Se saca de resend.com/api-keys (plan gratuito: 3.000 correos por mes).
RESEND_API_KEY=
# Remitente verificado en Resend. Va en un subdominio propio para no tocar
# los registros de Zoho del dominio principal.
RESEND_FROM=ONNIS & MEEKS <web@send.onnismeeks.com>
# A donde llegan las consultas. Por defecto, el correo de lib/site.ts.
CONTACT_INBOX=info@onnismeeks.com
